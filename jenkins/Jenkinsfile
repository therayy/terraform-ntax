pipeline {
  agent any

  environment {
    PATH = "/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    TF_WORKING_DIR = "training-evidence/workshop-3/vault-configuration"
  }

  stages {
    stage('Verify tools') {
      steps {
        sh '''
          set -eu
          git --version
          terraform version
          trivy --version
        '''
      }
    }

    stage('Terraform format') {
      steps {
        sh 'terraform fmt -check -recursive'
      }
    }

    stage('Terraform validate') {
      steps {
        sh '''
          set -eu

          terraform \
            -chdir="$TF_WORKING_DIR" \
            init -backend=false -input=false

          terraform \
            -chdir="$TF_WORKING_DIR" \
            validate
        '''
      }
    }

    stage('Security scan') {
      steps {
        sh '''
          trivy config \
            --exit-code 1 \
            --severity HIGH,CRITICAL \
            .
        '''
      }
    }
  }

  post {
    success {
      echo 'Validation and security checks passed.'
    }

    failure {
      echo 'A Jenkins validation or security check failed.'
    }
  }
}
